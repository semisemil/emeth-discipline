{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{ "type": "command", "command": "node", "args": ["${MIXDOG_PLUGIN_ROOT}/hooks/run.js"], "timeout": 20 }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{ "type": "command", "command": "node", "args": ["${MIXDOG_PLUGIN_ROOT}/hooks/run.js"], "timeout": 10 }]
    }],
    "PreToolUse": [{
      "matcher": "agent",
      "hooks": [{ "type": "command", "command": "node", "args": ["${MIXDOG_PLUGIN_ROOT}/hooks/run.js"], "timeout": 10 }]
    }]
  }
}
